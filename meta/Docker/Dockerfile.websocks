FROM node:18-alpine AS BUILDER
WORKDIR /app

# Copy package.json files for workspace setup
COPY package*.json ./
COPY apps/websocks/package*.json ./apps/websocks/
COPY packages/db/package*.json ./packages/db/

# Copy source code
COPY apps/websocks ./apps/websocks
COPY packages ./packages

# Install from root to resolve workspace dependencies
RUN npm install

# Generate Prisma client in db package
WORKDIR /app/packages/db
RUN npx prisma generate

# Build the WebSocket app
WORKDIR /app/apps/websocks
RUN npm run build

EXPOSE 3000
CMD ["node","dist/index.js"]
